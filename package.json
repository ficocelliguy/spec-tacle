{
  "name": "spec-tacle",
  "version": "0.1.0",
  "description": "Turn a software spec into an editable HTML visualizer — technical summary, mermaid diagrams, per-node/arrow descriptions, and round-trip back to the spec file.",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "demo": "node ./bin/spec-tacle.js demo",
    "render": "node ./bin/spec-tacle.js render",
    "serve": "node ./bin/spec-tacle.js serve",
    "start": "node ./bin/spec-tacle.js serve",
    "example": "node ./bin/spec-tacle.js example",
    "skill": "node ./bin/spec-tacle.js skill"
  },
  "bin": {
    "spec-tacle": "./bin/spec-tacle.js"
  },
  "files": [
    "bin",
    "lib",
    "skill",
    "example",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "spec",
    "mermaid",
    "diagram",
    "documentation",
    "visualizer",
    "software-spec",
    "claude",
    "ai-editor",
    "round-trip"
  ],
  "author": "Michael Ficocelli",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/michaelficocelli/spec-tacle"
  },
  "homepage": "https://github.com/michaelficocelli/spec-tacle#readme",
  "bugs": {
    "url": "https://github.com/michaelficocelli/spec-tacle/issues"
  }
}
